{
  "name": "dx3rd-scenario-ammo",
  "version": "0.1.0",
  "private": true,
  "description": "Double Cross 3rd scenario authoring and parsing tools",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build:cli && vitest run",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:watch": "vitest",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:html": "npm run build:cli && node dist/cli/main.js build html",
    "build:pdf": "npm run build:cli && node dist/cli/main.js build pdf"
  },
  "dependencies": {
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vivliostyle/core": "2.45.0",
    "puppeteer-core": "25.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
